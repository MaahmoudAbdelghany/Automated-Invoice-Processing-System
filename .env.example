# ============================================
# Automated Invoice Processing System
# Environment Configuration (Arabic-First)
# ============================================
# Copy this file to .env and fill in your values.

# --- Application ---
APP_NAME=Automated Invoice Processing System
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# --- AWS General ---
AWS_REGION=us-east-1

# --- AWS S3 ---
S3_BUCKET_NAME=my-invoice-bucket
S3_UPLOAD_PREFIX=uploads/

# --- AWS DynamoDB ---
DYNAMODB_TABLE_NAME=invoices

# --- AWS Textract (OCR) ---
# Leave empty to use AWS_REGION
TEXTRACT_REGION=

# --- AWS Bedrock (NLP) ---
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Leave empty to use AWS_REGION
BEDROCK_REGION=

# --- AWS SES (Notifications) ---
SES_SENDER_EMAIL=noreply@example.com
# Leave empty to use AWS_REGION
SES_REGION=

# --- Processing ---
CONFIDENCE_THRESHOLD=0.85
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=["ar", "en"]

# --- File Upload ---
MAX_FILE_SIZE_MB=10
