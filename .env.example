# ============================================
# Automated Invoice Processing System
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# --- Application ---
APP_NAME=Automated Invoice Processing System
APP_VERSION=0.1.0
DEBUG=True

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# SQLite (default):
DATABASE_URL=sqlite:///./invoices.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/invoices

# --- OCR ---
# Path to Tesseract executable (update if not on PATH)
TESSERACT_CMD=tesseract

# --- File Upload ---
MAX_FILE_SIZE_MB=10
